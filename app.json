{
  "expo": {
    "name": "Upande Dev Tools",
    "slug": "upande-dev-tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo.png",
    "scheme": "upandedevtools",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.upande.devtools",
      "supportsTablet": false
    },
    "android": {
      "package": "com.upande.devtools",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/upande_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Upande Dev Tools with Face ID"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/upande_logo.png",
          "color": "#171717"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
