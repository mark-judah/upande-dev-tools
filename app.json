{
  "expo": {
    "name": "Upande Dev Tools",
    "slug": "upande-dev-tools",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo.png",
    "scheme": "upandedevtools",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.upande.devtools",
      "supportsTablet": false
    },
    "android": {
      "package": "com.upande.devtools",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/upande_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 5002
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withBuildTuning",
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Upande Dev Tools with Face ID"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/upande_logo.png",
          "color": "#171717"
        }
      ],
      "@upande/mobile-kit",
      "expo-localization",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "otaBaseUrl": "https://mark-judah.github.io/upande-dev-tools/ota",
      "mobileKit": {
        "_help": "All of the kit's settings for this app live here. Edit the lists under \"release\"; the kit manages nativeBaseline and apkTag itself.",
        "sites": {
          "production": "https://kaitet-group.upande.com",
          "development": "http://192.168.8.4"
        },
        "versionCodeBase": 0,
        "runtimeMajorBase": 0,
        "release": {
          "_help": "Decides APK or OTA for you. \"apk\": folders/files (globs) that need a new APK when they change, e.g. \"modules/**\". \"ota\": folders/files that are safe over the air, e.g. \"assets/fonts/**\". Built in: app/**, src/**, tests, docs, *.md are OTA; android/**, ios/**, patches/**, plugins/** are APK. A changed file in neither list builds an APK to be safe, and the release says which file to list.",
          "apk": [
            "assets/images/**"
          ],
          "ota": [
            "assets/**",
            "docs/**",
            ".vscode/**",
            "*.config.js",
            "tsconfig.json",
            "expo-env.d.ts"
          ]
        },
        "nativeBaseline": {
          "hash": "1f5fa9b810cb",
          "parts": {
            "@expo/ui": "58.0.28",
            "@react-native-async-storage/async-storage": "2.2.0",
            "@upande/mobile-kit (native modules and plugins)": "d68dd8e90411",
            "expo": "58.0.25",
            "expo-audio": "58.0.12",
            "expo-battery": "58.0.4",
            "expo-build-properties": "58.0.12",
            "expo-constants": "58.0.16",
            "expo-device": "58.0.5",
            "expo-file-system": "58.0.13",
            "expo-font": "58.0.12",
            "expo-glass-effect": "58.0.5",
            "expo-haptics": "58.0.8",
            "expo-image": "58.0.18",
            "expo-intent-launcher": "58.0.3",
            "expo-linking": "58.0.17",
            "expo-local-authentication": "58.0.3",
            "expo-localization": "58.0.5",
            "expo-network": "58.0.5",
            "expo-notifications": "58.1.9",
            "expo-router": "58.0.31",
            "expo-secure-store": "58.0.3",
            "expo-splash-screen": "58.0.14",
            "expo-status-bar": "58.0.5",
            "expo-symbols": "58.0.5",
            "expo-system-ui": "58.0.7",
            "expo-updates": "58.0.22",
            "expo-web-browser": "58.0.8",
            "react-native": "0.88.1",
            "react-native-gesture-handler": "3.3.0",
            "react-native-reanimated": "4.7.1",
            "react-native-safe-area-context": "5.11.1",
            "react-native-screens": "4.30.1",
            "react-native-worklets": "0.13.0",
            "app.json (native fields)": "b63798f30af4"
          }
        },
        "apkTag": "v1.0.2"
      },
      "runtimeSdk": 58
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://kaitet-group.upande.com/api/method/upande_mobile.api.ota.manifest?app=Upande%20Dev%20Tools"
    },
    "runtimeVersion": "1.0"
  }
